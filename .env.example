# ------------------------------------------------------------------------------
# Connection Manager – Environment Variables
# In Portainer unter "Environment Variables" beim Stack eintragen.
# Pflicht: POSTGRES_PASSWORD, JWT_SECRET (+ BASE_IMAGE/POSTGRES_IMAGE prüfen)
# ------------------------------------------------------------------------------

# --- Datenbank ---------------------------------------------------------------
POSTGRES_DB=devicedb
POSTGRES_USER=deviceapp
POSTGRES_PASSWORD=
# Host-Bindung für PostgreSQL (nur localhost des Docker-Hosts)
DB_PORT=127.0.0.1:5433

# DB-Pool des Backends (Defaults sind für ~10 gleichzeitige Nutzer ausgelegt)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_CONNECT_RETRIES=30

# --- Auth / API ----------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRE_HOURS=8
CORS_ORIGINS=*
API_PREFIX=/api/v1

# --- Netzwerk / Ports --------------------------------------------------------------
BACKEND_PORT=8082
PROXY_NETWORK=nginx-proxy-manager_default

# --- Images (Equinix-Registry, gepinnt – exakte Pfade im InfoSec-Katalog prüfen) ---
BASE_IMAGE=appsec.docker.equinix.com/infosec/python:3.11-slim
POSTGRES_IMAGE=appsec.docker.equinix.com/infosec/postgres:17
PGADMIN_IMAGE=appsec.docker.equinix.com/infosec/pgadmin4:8
PIP_INDEX_URL=https://nexus.equinix.com/repository/pypi-mirror/simple/

# Versions-Tag, erscheint in /health und im Frontend-Footer der Navigation
APP_VERSION=2026.10.23

# --- Betrieb -------------------------------------------------------------------------
LOG_LEVEL=info

# --- pgAdmin (optional; nur mit COMPOSE_PROFILES=tools aktiv) ---------------------------
# COMPOSE_PROFILES=tools
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=
PGADMIN_PORT=127.0.0.1:5051
